{
  "backbone": "bert-base-uncased",
  "architecture": "soft_sharing",
  "tasks": ["sentiment", "emotion", "intensity"],
  "seed": 42,
  "dataset": "data/prepared/meisd-study2-v1",
  "output": "outputs/example-meisd-soft-seed42",
  "epochs": 6,
  "batch_size": 16,
  "max_length": 192,
  "learning_rate": 0.00002,
  "soft_lambda": 0.0001,
  "soft_normalization": "mean_pairs",
  "diagnostics": true
}
